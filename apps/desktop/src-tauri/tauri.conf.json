{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tongyun-database",
  "version": "0.1.1",
  "identifier": "dev.tongyun.database",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "橦云数据库",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "visible": true,
        "focus": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; frame-src http://127.0.0.1:* http://localhost:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../../../src": "sidecar/src",
      "../../../public": "sidecar/public",
      "../../../package.json": "sidecar/package.json",
      "../../../node_modules": "sidecar/node_modules"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2RDRDQ0NDNTcxQkY3NDkKUldSSjl4dFh6TXpVTnViRCs2OFRITVZWTEVaUk9heFA4NzFHR2Rxa0JuaXo0eW10dUluMm45VkcK",
      "endpoints": [
        "https://github.com/dangzhuotong/tongyun-database/releases/latest/download/latest.json"
      ]
    }
  }
}
